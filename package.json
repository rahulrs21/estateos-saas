{
  "name": "estateos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "predev": "node scripts/check-node-version.mjs",
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "next build",
    "prestart": "node scripts/check-node-version.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:auth && npm run test:tenancy && npm run test:leads",
    "test:auth": "node scripts/test-auth.mjs",
    "test:auth:emulator": "node scripts/test-auth-emulator.mjs",
    "test:tenancy": "node scripts/test-tenancy.mjs",
    "test:leads": "node scripts/test-leads.mjs",
    "test:sidebar": "node scripts/test-sidebar.mjs",
    "sql:validate": "node scripts/sql-connect-toolkit.mjs build",
    "sql:generate": "node scripts/sql-connect-toolkit.mjs generate",
    "sql:emulators": "firebase emulators:start --project demo-estateos --only dataconnect",
    "sql:seed": "node scripts/seed-sql-connect.mjs",
    "test:dataconnect": "firebase emulators:exec --project demo-estateos --config firebase.test.json --only dataconnect \"node --test tests/sql-connect.integration.test.mjs\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dataconnect/admin-generated": "file:src/dataconnect-admin-generated",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
