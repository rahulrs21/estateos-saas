# All values below are placeholders. Never commit real server credentials.
# Preserve existing .env.local values when adding these variable names.
# Restart dev after changes; rebuild to update NEXT_PUBLIC_ values.

# Firebase browser web-app configuration (public identifiers, not Admin secrets).
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDma3yCdDiBwt7EU390OFvmUaT7raQ2310"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="estateos-development-f8c93.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="estateos-development-f8c93"
NEXT_PUBLIC_FIREBASE_APP_ID="1:223592917075:web:b8cd417b9623754688bea6"

# Exact canonical origin, without path, query, or trailing slash.
# Development: use this exact browser host, not 127.0.0.1.
# Production: replace with your https:// deployment origin.
APP_ORIGIN=http://localhost:3000

# Must match NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID="estateos-development-f8c93"

# Preferred: Application Default Credentials (ADC).
# On supported Google hosting, use an appropriately scoped service identity.
# Locally, optionally set a path OUTSIDE this repository to a securely stored
# service-account JSON file. Never commit that file.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/location/service-account.json

# Alternative to ADC: set BOTH server-only variables below.
# Keep quotes and literal \n separators when using a one-line private key.
# Leave unset when using ADC; never add a NEXT_PUBLIC_ prefix.
# FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# SQL Connect routing is independent of Firebase Authentication.
# Prefer npm run dev:local to start SQL Connect + Next.js with local routing.
# Manual local development only: the emulator must already be running.
# DATA_CONNECT_EMULATOR_HOST=127.0.0.1:9399
# Leave unset for a hosted backend with the matching schema/connector deployed.

# Team invitation expiry: integer hours, 1..168; default is seven days.
INVITATION_TTL_HOURS=168
# Leave provider unset in development for an explicitly unsent private preview.
# Production requires a configured provider and verified sender.
# INVITATION_EMAIL_PROVIDER=resend
# RESEND_API_KEY=your-server-only-provider-key
# INVITATION_EMAIL_FROM=team@your-verified-domain.example
