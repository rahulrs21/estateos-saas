# All values below are placeholders. Never commit real server credentials.
# Preserve existing .env.local values when adding these variable names.
# Restart dev after changes; rebuild to update NEXT_PUBLIC_ values.

# Firebase browser web-app configuration (public identifiers, not Admin secrets).
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDma3yCdDiBwt7EU390OFvmUaT7raQ2310"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="estateos-development-f8c93.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="estateos-development-f8c93"
NEXT_PUBLIC_FIREBASE_APP_ID="1:223592917075:web:b8cd417b9623754688bea6"

# Exact canonical origin, without path, query, or trailing slash.
# Development: use this exact browser host, not 127.0.0.1.
# Production: replace with your https:// deployment origin.
APP_ORIGIN=http://localhost:3000

# Must match NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID="estateos-development-f8c93"

# Preferred: Application Default Credentials (ADC).
# On supported Google hosting, use an appropriately scoped service identity.
# Locally, optionally set a path OUTSIDE this repository to a securely stored
# service-account JSON file. Never commit that file.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/location/service-account.json

# Alternative to ADC: set BOTH server-only variables below.
# Keep quotes and literal \n separators when using a one-line private key.
# Leave unset when using ADC; never add a NEXT_PUBLIC_ prefix.
# FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Server-side Firebase Storage bucket for private inventory media. Find this in
# Firebase Console > Storage. The value is a bucket name only, without gs://.
# FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"

# Maps (Phase 5F, see docs/MAPS.md). All optional. Without a Google browser key,
# maps use OpenStreetMap tiles (no key or billing); address search needs Google.
# auto (default) | google | osm | none (no third-party map tiles at all).
# NEXT_PUBLIC_MAP_PROVIDER=auto
# Public browser key, restricted to your HTTP referrers. Draws maps (Maps
# JavaScript API). If GOOGLE_MAPS_SERVER_KEY is unset, address search also runs
# in the browser with this key, so it must then allow Places API (New) and
# Geocoding API too.
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your-referrer-restricted-browser-key
# Map ID for advanced markers and clustering; defaults to Google's DEMO_MAP_ID (development only).
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id
# Optional server-only key for Places API (New) and Geocoding API. Recommended:
# lookups then go through the server's per-member/IP/company rate limits.
# Never add NEXT_PUBLIC_.
# GOOGLE_MAPS_SERVER_KEY=your-server-only-maps-key
# Pins per map request, 50-1000 (default 500). The map pages beyond this.
# MAPS_PIN_QUERY_LIMIT=500

# API rate limiting (src/lib/rate-limit). Default backend: sql-connect, shared
# by every app instance through the app database. "memory" is per-process and
# for local development only (refused in production).
# RATE_LIMIT_BACKEND=sql-connect
# Server-only secret mixed into stored bucket keys (any long random string).
# RATE_LIMIT_KEY_SECRET=generate-a-long-random-value
# Proxies in front of the app that append X-Forwarded-For. 0 (default) ignores
# forwarded headers, so per-IP limits are off. Firebase App Hosting: 1.
# RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# SQL Connect routing is independent of Firebase Authentication.
# Prefer npm run dev:local to start SQL Connect + Next.js with local routing.
# Manual local development only: the emulator must already be running.
# DATA_CONNECT_EMULATOR_HOST=127.0.0.1:9399
# Leave unset for a hosted backend with the matching schema/connector deployed.

# Team invitation expiry: integer hours, 1..168; default is seven days.
INVITATION_TTL_HOURS=168
# Leave provider unset in development for an explicitly unsent private preview.
# Production requires a configured provider and verified sender.
# INVITATION_EMAIL_PROVIDER=resend
# RESEND_API_KEY=your-server-only-provider-key
# INVITATION_EMAIL_FROM=team@your-verified-domain.example

# AI Copilot (Phase 6A, see docs/AI_COPILOT.md). Server-only; never add
# NEXT_PUBLIC_. Without ESTATEOS_AI_ENABLED=true and a valid key the Copilot
# shows a "not configured" state; there is no mock or fallback provider.
# Hosted: store ANTHROPIC_API_KEY in Secret Manager (apphosting.yaml secret).
ESTATEOS_AI_ENABLED=false
# ANTHROPIC_API_KEY=your-server-only-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium (default) | high
# ANTHROPIC_EFFORT=medium
# default (server-side refusal fallback on supported models) | off
# ANTHROPIC_REFUSAL_FALLBACK=default
# Limits (defaults shown). Allowances are per UTC calendar month.
# AI_MONTHLY_REQUESTS_PER_ORGANIZATION=2000
# AI_MONTHLY_REQUESTS_PER_USER=300
# AI_REQUESTS_PER_MINUTE_PER_MEMBER=6
# AI_REQUESTS_PER_MINUTE_PER_ORGANIZATION=60
# AI_MAX_OUTPUT_TOKENS=8000
# AI_MAX_TOOL_ROUNDS=5
# AI_MAX_TOOL_CALLS=12
# AI_REQUEST_TIMEOUT_MS=120000
# AI_TOOL_TIMEOUT_MS=15000
# AI_MAX_INPUT_CHARS=4000
# AI_HISTORY_MESSAGES=20
# Days to keep a member's conversations after their last message; 0 keeps them.
# AI_CONVERSATION_RETENTION_DAYS=180
# Optional price override for cost estimates (USD per million tokens).
# AI_PRICE_INPUT_PER_MTOK=2
# AI_PRICE_OUTPUT_PER_MTOK=10
# AI Content Studio (Phase 6B, see docs/AI_CONTENT_STUDIO.md). Uses the same
# Anthropic key, model, allowances and rate limits as the Copilot.
# AI_CONTENT_MAX_OUTPUT_TOKENS=16000
# AI_CONTENT_REQUEST_TIMEOUT_MS=180000
# AI_CONTENT_MAX_INSTRUCTIONS_CHARS=1500
# Optional ad text limit overrides (docs/AI_TEMPLATES.md#advertising-limits).
# AI_AD_LIMITS={"META":{"primaryText":125}}
# Phase 6C lead scoring overrides (docs/AI_LEAD_QUALIFICATION.md#configuration). Optional;
# invalid values stop scoring with a clear error rather than silently changing scores.
# AI_LEAD_SCORING={"weights":{"viewings":20},"thresholds":{"high":75,"medium":50}}
